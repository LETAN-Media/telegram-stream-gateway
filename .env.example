# Copy to .env and fill values. NEVER commit .env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Either a session string (preferred, works on Northflank non-interactive)...
TELEGRAM_SESSION_STRING=
# ...or a bot token (bot must be admin of the channel).
TELEGRAM_BOT_TOKEN=

ALLOWED_CHAT_IDS=-1001234567890
STREAM_SIGNING_SECRET=change-me-to-a-long-random-string
ALLOW_UNSIGNED_STREAMS=false

MAX_CONCURRENT_STREAMS=4
TELEGRAM_CHUNK_SIZE=524288
REQUEST_TIMEOUT_SECONDS=30
PORT=8080
LOG_LEVEL=info
